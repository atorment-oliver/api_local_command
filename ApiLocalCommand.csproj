<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <Target Name="CopyComandosMDBToBuildOutput" AfterTargets="Build">
    <PropertyGroup>
      <MdbDllPath>$(MSBuildProjectDirectory)\native\ComandosMDB\x64\$(Configuration)\ComandosMDB.dll</MdbDllPath>
    </PropertyGroup>
    <Error
      Condition="!Exists('$(MdbDllPath)')"
      Text="No se generó ComandosMDB.dll en $(MdbDllPath). Compila la solución ApiLocalCommand.sln con la configuración x64." />
    <Copy SourceFiles="$(MdbDllPath)" DestinationFolder="$(TargetDir)" />
  </Target>
  <Target Name="CopyComandosMDBToPublishOutput" AfterTargets="Publish">
    <PropertyGroup>
      <MdbDllPath>$(MSBuildProjectDirectory)\native\ComandosMDB\x64\$(Configuration)\ComandosMDB.dll</MdbDllPath>
    </PropertyGroup>
    <Error
      Condition="!Exists('$(MdbDllPath)')"
      Text="No se generó ComandosMDB.dll en $(MdbDllPath). Compila la solución ApiLocalCommand.sln con la configuración x64 antes de publicar." />
    <Copy SourceFiles="$(MdbDllPath)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
